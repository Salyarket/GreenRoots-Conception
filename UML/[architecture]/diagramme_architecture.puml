@startuml Diagramme d'architecture GreenRoots
node "Client (navigateur)" {
  [Front : Next.js/React]
}

node "Serveur API" {
  [Backend : Express.js + TypeScript]
  [Auth : JWT + Refresh tokens]
}

database "Base de données" {
  [PostgreSQL]
}

[Front : Next.js/React] <--> [Backend : Express.js + TypeScript] : HTTP (REST API)
[Backend : Express.js + TypeScript] <--> [PostgreSQL] : SQL (Prisma ORM)
[Backend : Express.js + TypeScript] --> [Auth : JWT + Refresh tokens] : login/refresh/verify
[Auth : JWT + Refresh tokens] --> [PostgreSQL] : refresh_token
@enduml
